FROM rust:1.99-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS plugin-build
WORKDIR /workspace
ARG HITO_PLUGIN_CACHE_ID=hito-plugin-jamendo-standalone
ARG TARGETARCH
ENV CARGO_TARGET_DIR=/build/jamendo-release-target \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_INCREMENTAL=false \
    CARGO_INCREMENTAL=0
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
COPY plugins plugins
COPY vendor vendor
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=${HITO_PLUGIN_CACHE_ID}-${TARGETARCH},target=/build/jamendo-release-target cargo build --locked --release -j 2 -p hito-plugin-jamendo && cp /build/jamendo-release-target/release/hito-plugin-jamendo /hito-plugin-jamendo

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && groupadd --gid 10001 hito-plugin && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hito-plugin && install -d -o 10001 -g 10001 -m 0700 /run/secrets
COPY --from=plugin-build --chown=0:0 --chmod=0555 /hito-plugin-jamendo /usr/local/bin/hito-plugin-jamendo
USER 10001:10001
EXPOSE 8093
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 CMD curl -fsS --max-time 2 --output /dev/null http://127.0.0.1:8093/v1/manifest || exit 1
ENTRYPOINT ["/usr/local/bin/hito-plugin-jamendo"]
CMD ["--client-id-file", "/run/secrets/jamendo-client-id", "--listen", "0.0.0.0:8093"]
