FROM rust:1.99-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS plugin-build
WORKDIR /workspace
ARG HITO_PLUGIN_CACHE_ID=hito-plugin-real-debrid-standalone
ARG HITO_REAL_DEBRID_SOURCE_ID
ARG TARGETARCH
ENV CARGO_TARGET_DIR=/build/real-debrid-release-target \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_INCREMENTAL=false \
    CARGO_INCREMENTAL=0
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
COPY vendor vendor
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=${HITO_PLUGIN_CACHE_ID}-${HITO_REAL_DEBRID_SOURCE_ID}-${TARGETARCH},target=/build/real-debrid-release-target \
    if [ -z "${HITO_REAL_DEBRID_SOURCE_ID}" ]; then printf '%s\n' 'Set HITO_REAL_DEBRID_SOURCE_ID to the immutable source snapshot ID before building.' >&2; exit 1; fi && \
    cargo build --locked --release -j 2 -p hito-plugin-real-debrid --bin hito-plugin-real-debrid && \
    cp /build/real-debrid-release-target/release/hito-plugin-real-debrid /hito-plugin-real-debrid

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG HITO_REAL_DEBRID_SOURCE_ID
LABEL org.opencontainers.image.revision="${HITO_REAL_DEBRID_SOURCE_ID}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && groupadd --gid 10001 hito-plugin && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hito-plugin && install -d -o 10001 -g 10001 -m 0700 /run/secrets
COPY --from=plugin-build --chown=0:0 --chmod=0555 /hito-plugin-real-debrid /usr/local/bin/hito-plugin-real-debrid
COPY --chown=0:0 --chmod=0444 LICENSE /usr/local/share/licenses/hito-plugin-real-debrid/LICENSE
COPY --chown=0:0 --chmod=0444 crates/hito-plugin-sdk/LICENSE /usr/local/share/licenses/hito-plugin-sdk/LICENSE
USER 10001:10001
EXPOSE 8096
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 CMD curl -fsS --noproxy '*' --max-time 2 --output /dev/null http://127.0.0.1:8096/v1/manifest || exit 1
ENTRYPOINT ["/usr/local/bin/hito-plugin-real-debrid"]
CMD ["--provider-token-file", "/run/secrets/real-debrid-provider-token", "--service-token-file", "/run/secrets/real-debrid-service-token", "--catalog-file", "/run/secrets/real-debrid-catalog.json", "--listen", "0.0.0.0:8096"]
