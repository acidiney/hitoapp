FROM rust:1.99-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS plugin-build
WORKDIR /workspace
ARG HITO_PLUGIN_CACHE_ID=hito-plugin-torbox-package-standalone
ARG HITO_TORBOX_SOURCE_ID
ARG HITO_TORBOX_INPUT_SHA256
ARG TARGETARCH
ENV CARGO_TARGET_DIR=/build/torbox-package-release-target \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_INCREMENTAL=false \
    CARGO_INCREMENTAL=0
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
COPY vendor vendor
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=${HITO_PLUGIN_CACHE_ID}-${HITO_TORBOX_SOURCE_ID}-${HITO_TORBOX_INPUT_SHA256}-${TARGETARCH},target=/build/torbox-package-release-target \
    printf '%s\n' "${HITO_TORBOX_SOURCE_ID}" | grep -Eq '^[0-9a-f]{40}$' && \
    printf '%s\n' "${HITO_TORBOX_INPUT_SHA256}" | grep -Eq '^[0-9a-f]{64}$' && \
    printf '%s\n' "${TARGETARCH}" | grep -Eq '^[a-z0-9][a-z0-9_]*$' && \
    cargo build --locked --offline --release -j 2 -p hito-plugin-torbox --bin hito-plugin-torbox && \
    cp /build/torbox-package-release-target/release/hito-plugin-torbox /hito-plugin-torbox

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG HITO_TORBOX_SOURCE_ID
ARG HITO_TORBOX_INPUT_SHA256
ARG TARGETARCH
LABEL org.opencontainers.image.revision="${HITO_TORBOX_SOURCE_ID}" \
      org.hito.product-input-sha256="${HITO_TORBOX_INPUT_SHA256}" \
      org.hito.build-target-arch="${TARGETARCH}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && groupadd --gid 10001 hito-plugin && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hito-plugin && install -d -o 10001 -g 10001 -m 0700 /run/secrets /var/lib/hito-torbox
COPY --from=plugin-build --chown=0:0 --chmod=0555 /hito-plugin-torbox /usr/local/bin/hito-plugin-torbox
COPY --chown=0:0 --chmod=0444 LICENSE /usr/local/share/licenses/hito-plugin-torbox/LICENSE
COPY --chown=0:0 --chmod=0444 crates/plugin-sdk/LICENSE /usr/local/share/licenses/hito-plugin-sdk/LICENSE
USER 10001:10001
EXPOSE 8100
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=3 CMD curl -fsS --noproxy '*' --max-time 2 --output /dev/null http://127.0.0.1:8100/v1/manifest || exit 1
ENTRYPOINT ["/usr/local/bin/hito-plugin-torbox"]
CMD ["--listen", "0.0.0.0:8100"]
