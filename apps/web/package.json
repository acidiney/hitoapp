{
  "name": "@hito/web",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.e2e.json && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:collection-artwork": "playwright test -c playwright.collection-artwork.config.ts",
    "e2e:community-ranking": "playwright test -c playwright.community-ranking.config.ts",
    "e2e:plugin-authorization": "playwright test -c playwright.plugin-authorization.config.ts",
    "e2e:lyric-provider-choice": "playwright test -c playwright.lyric-provider-choice.config.ts",
    "generate:api": "openapi-typescript ../../docs/openapi.json -o src/generated.ts",
    "lint": "prettier --check . && tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit && eslint . --max-warnings 71"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@inertiajs/react": "3.9.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
