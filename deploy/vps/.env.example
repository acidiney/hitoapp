# Copy to the private deployment directory as .env, mode 0600.
# Record the full clean source commit and the immutable IDs after loading images.
HITO_VPS_REVISION=
HITO_SERVER_IMAGE=
HITO_FOLDER_IMAGE=
HITO_SPOTIFY_IMAGE=
HITO_YOUTUBE_IMAGE=

# Existing paths on the VPS. No provider credentials belong in this file.
HITO_VPS_MUSIC_DIR=/srv/hito/music
HITO_VPS_STORAGE_MANIFEST=/srv/hito/config/storage.json
