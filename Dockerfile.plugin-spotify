FROM rust:1.99-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS plugin-build
WORKDIR /workspace
ARG HITO_PLUGIN_CACHE_ID=hito-plugin-spotify-public-standalone
ENV CARGO_TARGET_DIR=/build/spotify-public-release-target \
    CARGO_BUILD_JOBS=2 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0 \
    CARGO_PROFILE_RELEASE_INCREMENTAL=false \
    CARGO_INCREMENTAL=0
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY crates crates
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,id=${HITO_PLUGIN_CACHE_ID},target=/build/spotify-public-release-target cargo build --locked --release -j 2 -p hito-plugin-spotify && cp /build/spotify-public-release-target/release/hito-plugin-spotify /hito-plugin-spotify

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin hito-plugin
COPY --from=plugin-build /hito-plugin-spotify /usr/local/bin/hito-plugin-spotify
USER 10001:10001
EXPOSE 8092
HEALTHCHECK --interval=5s --timeout=3s CMD curl -fsS --max-time 2 --output /dev/null http://127.0.0.1:8092/v1/manifest || exit 1
ENTRYPOINT ["hito-plugin-spotify"]
CMD ["--listen", "0.0.0.0:8092"]
